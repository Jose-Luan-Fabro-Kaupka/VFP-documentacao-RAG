*********************************
DEFINE CLASS C_Contador AS Custom
*********************************

   nValor = 0

   **********************
   FUNCTION F_Incrementar
   **********************
   PARAMETERS nQuantidade
   PRIVATE    nQuantidade

      THIS.nValor = THIS.nValor + nQuantidade

      RETURN(THIS.nValor)

   ENDFUNC

   ****************
   FUNCTION F_Zerar
   ****************

      THIS.nValor = 0

      RETURN(THIS.nValor)

   ENDFUNC

ENDDEFINE

************************************
DEFINE CLASS C_Calculadora AS Custom
************************************

   ****************
   FUNCTION F_Somar
   ****************
   PARAMETERS nValor1, nValor2
   PRIVATE    nValor1, nValor2

      RETURN(nValor1 + nValor2)

   ENDFUNC

   *******************
   FUNCTION F_Subtrair
   *******************
   PARAMETERS nValor1, nValor2
   PRIVATE    nValor1, nValor2

      RETURN(nValor1 - nValor2)

   ENDFUNC

ENDDEFINE

******************************
DEFINE CLASS C_Texto AS Custom
******************************

   cValor = ""

   ********************
   FUNCTION F_Maiusculo
   ********************

      RETURN(UPPER(THIS.cValor))

   ENDFUNC

   ******************
   FUNCTION F_Tamanho
   ******************

      RETURN(LEN(THIS.cValor))

   ENDFUNC

ENDDEFINE

