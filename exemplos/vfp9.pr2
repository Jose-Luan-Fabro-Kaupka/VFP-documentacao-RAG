FUNCTION F_CursorSalvar
***********************
PARAMETERS cAlias
PRIVATE    cAlias

   SELECT (cAlias)

   RETURN(TABLEUPDATE(.T., .F., cAlias))

ENDFUNC

**************************
PROCEDURE P_CursorReverter
**************************
PARAMETERS cAlias
PRIVATE    cAlias

   SELECT (cAlias)
   TABLEREVERT(.T., cAlias)

   RETURN

ENDPROC

**********************************
PROCEDURE P_ClienteDuplicadoCursor
**********************************
PRIVATE CursorClienteDuplicado

   SELECT Email, ;
          COUNT(*) AS Quantidade ;
   FROM Cliente ;
   WHERE NOT EMPTY(Email) ;
   GROUP BY Email ;
   HAVING COUNT(*) > 1 ;
   ORDER BY Quantidade DESC ;
   INTO CURSOR CursorClienteDuplicado READWRITE

   RETURN

ENDPROC

***********************************
PROCEDURE P_ProdutoValorFaixaCursor
***********************************
PARAMETERS nMinimo, nMaximo
PRIVATE    nMinimo, nMaximo, CursorProdutoFaixa

   SELECT Codigo, ;
          Descricao, ;
          Valor ;
   FROM Produto ;
   WHERE Valor BETWEEN nMinimo AND nMaximo ;
   ORDER BY Valor ;
   INTO CURSOR CursorProdutoFaixa READWRITE

   RETURN

ENDPROC

