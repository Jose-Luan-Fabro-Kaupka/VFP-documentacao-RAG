************************
FUNCTION F_ObjetoColecao
************************
PRIVATE oColecao

   oColecao = CREATEOBJECT("Collection")

   RETURN(oColecao)

ENDFUNC

****************************
PROCEDURE P_ColecaoAdicionar
****************************
PARAMETERS oColecao, uValor
PRIVATE    oColecao, uValor

   oColecao.Add(uValor)

   RETURN

ENDPROC

***************************
FUNCTION F_SistemaDiretorio
***************************
PRIVATE cDiretorio

   cDiretorio = SYS(5) + CURDIR()

   RETURN(cDiretorio)

ENDFUNC

****************************
FUNCTION F_SistemaTemporario
****************************
PRIVATE cDiretorio

   cDiretorio = SYS(2023)

   RETURN(cDiretorio)

ENDFUNC

*******************************
FUNCTION F_SistemaIdentificador
*******************************
PRIVATE cIdentificador

   cIdentificador = UPPER(STRTRAN(SYS(2015), "_", ""))

   RETURN(cIdentificador)

ENDFUNC

**************************
FUNCTION F_SistemaDataHora
**************************
PRIVATE tDataHora

   tDataHora = DATETIME()

   RETURN(tDataHora)

ENDFUNC

*************************
FUNCTION F_SistemaUsuario
*************************
PRIVATE cUsuario

   cUsuario = GETENV("USERNAME")

   RETURN(cUsuario)

ENDFUNC

****************************
FUNCTION F_SistemaComputador
****************************
PRIVATE cComputador

   cComputador = GETENV("COMPUTERNAME")

   RETURN(cComputador)

ENDFUNC

*********************
PROCEDURE P_LogGravar
*********************
PARAMETERS cMensagem, cArquivo
PRIVATE    cMensagem, cArquivo, cLinha

   cLinha = TTOC(DATETIME(), 1) + " | " + cMensagem + CHR(13) + CHR(10)

   STRTOFILE(cLinha, cArquivo, 1)

   RETURN

ENDPROC

**************************
FUNCTION F_ConfiguracaoLer
**************************
PARAMETERS cArquivo, cSecao, cChave
PRIVATE    cArquivo, cSecao, cChave, cValor

   cValor = SPACE(1024)

   DECLARE INTEGER GetPrivateProfileString IN Win32API ;
      STRING cSecao, STRING cChave, STRING cPadrao, ;
      STRING @cValor, INTEGER nTamanho, STRING cArquivo

   GetPrivateProfileString(cSecao, cChave, "", @cValor, LEN(cValor), cArquivo)

   CLEAR DLLS GetPrivateProfileString

   RETURN(LEFT(cValor, AT(CHR(0), cValor) - 1))

ENDFUNC

*****************************
FUNCTION F_ConfiguracaoGravar
*****************************
PARAMETERS cArquivo, cSecao, cChave, cValor
PRIVATE    cArquivo, cSecao, cChave, cValor, nRetorno

   DECLARE INTEGER WritePrivateProfileString IN Win32API ;
      STRING cSecao, STRING cChave, STRING cValor, STRING cArquivo

   nRetorno = WritePrivateProfileString(cSecao, cChave, cValor, cArquivo)

   CLEAR DLLS WritePrivateProfileString

   RETURN(nRetorno <> 0)

ENDFUNC

**************************
FUNCTION F_NumeroAleatorio
**************************
PARAMETERS nMinimo, nMaximo
PRIVATE    nMinimo, nMaximo, nValor

   nValor = INT((RAND() * ((nMaximo - nMinimo) + 1)) + nMinimo)

   RETURN(nValor)

ENDFUNC

*****************
FUNCTION F_CorRgb
*****************
PARAMETERS nVermelho, nVerde, nAzul
PRIVATE    nVermelho, nVerde, nAzul

   RETURN(RGB(nVermelho, nVerde, nAzul))

ENDFUNC

****************************
FUNCTION F_TempoMilissegundo
****************************
PRIVATE nTempo

   nTempo = SECONDS() * 1000

   RETURN(nTempo)

ENDFUNC

*******************
FUNCTION F_BitAtivo
*******************
PARAMETERS nValor, nPosicao
PRIVATE    nValor, nPosicao, nMascara

   nMascara = 2 ^ nPosicao

   RETURN(BITAND(nValor, nMascara) <> 0)

ENDFUNC
