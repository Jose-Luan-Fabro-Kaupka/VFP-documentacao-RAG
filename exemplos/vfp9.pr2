PROCEDURE P_CursorIndice
************************
PARAMETERS cAlias, cIndice
PRIVATE    cAlias, cIndice

   SELECT (cAlias)
   SET ORDER TO TAG (cIndice)

   RETURN

ENDPROC

***************************
PROCEDURE P_CursorAtualizar
***************************
PARAMETERS cAlias
PRIVATE    cAlias

