*************************
FUNCTION F_TextoMaiusculo
*************************
PARAMETERS cTexto
PRIVATE    cTexto

   RETURN(UPPER(ALLTRIM(cTexto)))

ENDFUNC

*************************
FUNCTION F_TextoMinusculo
*************************
PARAMETERS cTexto
PRIVATE    cTexto

   RETURN(LOWER(ALLTRIM(cTexto)))

ENDFUNC

***********************
FUNCTION F_TextoTamanho
***********************
PARAMETERS cTexto
PRIVATE    cTexto

   RETURN(LEN(ALLTRIM(cTexto)))

ENDFUNC

************************
FUNCTION F_TextoEsquerda
************************
PARAMETERS cTexto, nTamanho
PRIVATE    cTexto, nTamanho

   RETURN(LEFT(cTexto, nTamanho))

ENDFUNC

***********************
FUNCTION F_TextoDireita
***********************
PARAMETERS cTexto, nTamanho
PRIVATE    cTexto, nTamanho

   RETURN(RIGHT(cTexto, nTamanho))

ENDFUNC

**********************
FUNCTION F_TextoCentro
**********************
PARAMETERS cTexto, nInicio, nTamanho
PRIVATE    cTexto, nInicio, nTamanho

   RETURN(SUBSTR(cTexto, nInicio, nTamanho))

ENDFUNC

**************************
FUNCTION F_TextoSubstituir
**************************
PARAMETERS cTexto, cOrigem, cDestino
PRIVATE    cTexto, cOrigem, cDestino

   RETURN(STRTRAN(cTexto, cOrigem, cDestino))

ENDFUNC

***********************
FUNCTION F_TextoRepetir
***********************
PARAMETERS cTexto, nQuantidade
PRIVATE    cTexto, nQuantidade

   RETURN(REPLICATE(cTexto, nQuantidade))

ENDFUNC

**********************
FUNCTION F_TextoConter
**********************
PARAMETERS cTexto, cTrecho
PRIVATE    cTexto, cTrecho

   RETURN(AT(cTrecho, cTexto) > 0)

ENDFUNC

***********************
FUNCTION F_TextoPosicao
***********************
PARAMETERS cTexto, cTrecho
PRIVATE    cTexto, cTrecho

   RETURN(AT(cTrecho, cTexto))

ENDFUNC

****************************
FUNCTION F_TextoPosicaoFinal
****************************
PARAMETERS cTexto, cTrecho
PRIVATE    cTexto, cTrecho

   RETURN(RAT(cTrecho, cTexto))

ENDFUNC

*******************************
FUNCTION F_TextoPrimeiraPalavra
*******************************
PARAMETERS cTexto
PRIVATE    cTexto, nPosicao

   cTexto    = ALLTRIM(cTexto)
   nPosicao  = AT(" ", cTexto)

   IF nPosicao = 0 THEN
      RETURN(cTexto)
   ENDIF

   RETURN(LEFT(cTexto, nPosicao - 1))

ENDFUNC

*****************************
FUNCTION F_TextoUltimaPalavra
*****************************
PARAMETERS cTexto
PRIVATE    cTexto, nPosicao

   cTexto    = ALLTRIM(cTexto)
   nPosicao  = RAT(" ", cTexto)

   IF nPosicao = 0 THEN
      RETURN(cTexto)
   ENDIF

   RETURN(SUBSTR(cTexto, nPosicao + 1))

ENDFUNC

******************************
FUNCTION F_TextoEspacosRemover
******************************
PARAMETERS cTexto
PRIVATE    cTexto

   DO WHILE AT("  ", cTexto) > 0
      cTexto = STRTRAN(cTexto, "  ", " ")
   ENDDO

   RETURN(ALLTRIM(cTexto))

ENDFUNC

******************************
FUNCTION F_TextoAcentosRemover
******************************
PARAMETERS cTexto
PRIVATE    cTexto, cOrigem, cDestino, nIndice

   cOrigem  = "ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇáàâãäéèêëíìîïóòôõöúùûüç"
   cDestino = "AAAAAEEEEIIIIOOOOOUUUUCaaaaaeeeeiiiiooooouuuuc"

   FOR nIndice = 1 TO LEN(cOrigem)
      cTexto = STRTRAN(cTexto, SUBSTR(cOrigem, nIndice, 1), SUBSTR(cDestino, nIndice, 1))
   ENDFOR

   RETURN(cTexto)

ENDFUNC

*****************************
FUNCTION F_TextoNumerosManter
*****************************
PARAMETERS cTexto
PRIVATE    cTexto, cRetorno, cCaractere, nIndice

   cRetorno = ""

   FOR nIndice = 1 TO LEN(cTexto)

      cCaractere = SUBSTR(cTexto, nIndice, 1)

      IF AT(cCaractere, "0123456789") > 0 THEN
         cRetorno = cRetorno + cCaractere
      ENDIF

   ENDFOR

   RETURN(cRetorno)

ENDFUNC

****************************
FUNCTION F_TextoLetrasManter
****************************
PARAMETERS cTexto
PRIVATE    cTexto, cRetorno, cCaractere, nIndice

   cRetorno = ""

   FOR nIndice = 1 TO LEN(cTexto)

      cCaractere = SUBSTR(cTexto, nIndice, 1)

      IF AT(UPPER(cCaractere), "ABCDEFGHIJKLMNOPQRSTUVWXYZ") > 0 THEN
         cRetorno = cRetorno + cCaractere
      ENDIF

   ENDFOR

   RETURN(cRetorno)

ENDFUNC

************************
FUNCTION F_TextoInverter
************************
PARAMETERS cTexto
PRIVATE    cTexto, cRetorno, nIndice

   cRetorno = ""

   FOR nIndice = LEN(cTexto) TO 1 STEP -1
      cRetorno = cRetorno + SUBSTR(cTexto, nIndice, 1)
   ENDFOR

   RETURN(cRetorno)

ENDFUNC

**************************
FUNCTION F_TextoPalindromo
**************************
PARAMETERS cTexto
PRIVATE    cTexto, cComparacao

   cComparacao = LOWER(STRTRAN(ALLTRIM(cTexto), " ", ""))

   RETURN(cComparacao == F_TextoInverter(cComparacao))

ENDFUNC

***********************
FUNCTION F_TextoPrefixo
***********************
PARAMETERS cTexto, cPrefixo
PRIVATE    cTexto, cPrefixo

   RETURN(LEFT(cTexto, LEN(cPrefixo)) == cPrefixo)

ENDFUNC

**********************
FUNCTION F_TextoSufixo
**********************
PARAMETERS cTexto, cSufixo
PRIVATE    cTexto, cSufixo

   RETURN(RIGHT(cTexto, LEN(cSufixo)) == cSufixo)

ENDFUNC

***************************
FUNCTION F_TextoCapitalizar
***************************
PARAMETERS cTexto
PRIVATE    cTexto

   cTexto = LOWER(ALLTRIM(cTexto))

   RETURN(UPPER(LEFT(cTexto, 1)) + SUBSTR(cTexto, 2))

ENDFUNC

**************************
FUNCTION F_TextoLinhaCriar
**************************
PARAMETERS cCaractere, nTamanho
PRIVATE    cCaractere, nTamanho

   RETURN(REPLICATE(LEFT(cCaractere, 1), nTamanho))

ENDFUNC

********************************
FUNCTION F_TextoQuebraNormalizar
********************************
PARAMETERS cTexto
PRIVATE    cTexto

   cTexto = STRTRAN(cTexto, CHR(13) + CHR(10), CHR(10))
   cTexto = STRTRAN(cTexto, CHR(13), CHR(10))

   RETURN(cTexto)

ENDFUNC

*******************************
FUNCTION F_TextoLinhaQuantidade
*******************************
PARAMETERS cTexto
PRIVATE    cTexto

   cTexto = F_TextoQuebraNormalizar(cTexto)

   RETURN(OCCURS(CHR(10), cTexto) + 1)

ENDFUNC

**************************
FUNCTION F_TextoMascaraCpf
**************************
PARAMETERS cCpf
PRIVATE    cCpf

   cCpf = PADL(F_TextoNumerosManter(cCpf), 11, "0")

   RETURN(TRANSFORM(cCpf, "@R 999.999.999-99"))

ENDFUNC

**************************
FUNCTION F_TextoMascaraCep
**************************
PARAMETERS cCep
PRIVATE    cCep

   cCep = PADL(F_TextoNumerosManter(cCep), 8, "0")

   RETURN(TRANSFORM(cCep, "@R 99999-999"))

ENDFUNC

*******************************
FUNCTION F_TextoMascaraTelefone
*******************************
PARAMETERS cTelefone
PRIVATE    cTelefone

   cTelefone = F_TextoNumerosManter(cTelefone)

   IF LEN(cTelefone) = 11 THEN
      RETURN(TRANSFORM(cTelefone, "@R (99) 99999-9999"))
   ENDIF

   RETURN(TRANSFORM(cTelefone, "@R (99) 9999-9999"))

ENDFUNC

**************************
FUNCTION F_TextoCsvEscapar
**************************
PARAMETERS cTexto
PRIVATE    cTexto

   cTexto = STRTRAN(cTexto, '"', '""')

   IF AT(",", cTexto) > 0 OR AT(CHR(10), cTexto) > 0 OR AT(CHR(13), cTexto) > 0 OR AT('"', cTexto) > 0 THEN
      cTexto = '"' + cTexto + '"'
   ENDIF

   RETURN(cTexto)

ENDFUNC

***************************
FUNCTION F_TextoHtmlEscapar
***************************
PARAMETERS cTexto
PRIVATE    cTexto

   cTexto = STRTRAN(cTexto, "&", "&amp;")
   cTexto = STRTRAN(cTexto, "<", "&lt;")
   cTexto = STRTRAN(cTexto, ">", "&gt;")
   cTexto = STRTRAN(cTexto, '"', "&quot;")

   RETURN(cTexto)

ENDFUNC

*************************
FUNCTION F_NumeroAbsoluto
*************************
PARAMETERS nValor
PRIVATE    nValor

   RETURN(ABS(nValor))

ENDFUNC

***************************
FUNCTION F_NumeroArredondar
***************************
PARAMETERS nValor, nCasas
PRIVATE    nValor, nCasas

   RETURN(ROUND(nValor, nCasas))

ENDFUNC

************************
FUNCTION F_NumeroInteiro
************************
PARAMETERS nValor
PRIVATE    nValor

   RETURN(INT(nValor))

ENDFUNC

*********************
FUNCTION F_NumeroTeto
*********************
PARAMETERS nValor
PRIVATE    nValor, nInteiro

   nInteiro = INT(nValor)

   IF nValor > nInteiro THEN
      nInteiro = nInteiro + 1
   ENDIF

   RETURN(nInteiro)

ENDFUNC

*********************
FUNCTION F_NumeroPiso
*********************
PARAMETERS nValor
PRIVATE    nValor, nInteiro

   nInteiro = INT(nValor)

   IF nValor < 0 AND nValor <> nInteiro THEN
      nInteiro = nInteiro - 1
   ENDIF

   RETURN(nInteiro)

ENDFUNC

********************
FUNCTION F_NumeroPar
********************
PARAMETERS nValor
PRIVATE    nValor

   RETURN(MOD(nValor, 2) = 0)

ENDFUNC

**********************
FUNCTION F_NumeroImpar
**********************
PARAMETERS nValor
PRIVATE    nValor

   RETURN(MOD(nValor, 2) <> 0)

ENDFUNC

**********************
FUNCTION F_NumeroMaior
**********************
PARAMETERS nValor1, nValor2
PRIVATE    nValor1, nValor2

   RETURN(MAX(nValor1, nValor2))

ENDFUNC

**********************
FUNCTION F_NumeroMenor
**********************
PARAMETERS nValor1, nValor2
PRIVATE    nValor1, nValor2

   RETURN(MIN(nValor1, nValor2))

ENDFUNC

************************
FUNCTION F_NumeroLimitar
************************
PARAMETERS nValor, nMinimo, nMaximo
PRIVATE    nValor, nMinimo, nMaximo

   RETURN(MAX(nMinimo, MIN(nValor, nMaximo)))

ENDFUNC

***************************
FUNCTION F_NumeroPercentual
***************************
PARAMETERS nValor, nTotal
PRIVATE    nValor, nTotal

   IF nTotal = 0 THEN
      RETURN(0)
   ENDIF

   RETURN((nValor / nTotal) * 100)

ENDFUNC

*************************
FUNCTION F_NumeroDesconto
*************************
PARAMETERS nValor, nPercentual
PRIVATE    nValor, nPercentual

   RETURN(nValor - (nValor * nPercentual / 100))

ENDFUNC

**************************
FUNCTION F_NumeroAcrescimo
**************************
PARAMETERS nValor, nPercentual
PRIVATE    nValor, nPercentual

   RETURN(nValor + (nValor * nPercentual / 100))

ENDFUNC

**********************
FUNCTION F_NumeroMedia
**********************
PARAMETERS nValor1, nValor2
PRIVATE    nValor1, nValor2

   RETURN((nValor1 + nValor2) / 2)

ENDFUNC

*******************************
FUNCTION F_NumeroMediaPonderada
*******************************
PARAMETERS nValor1, nPeso1, nValor2, nPeso2
PRIVATE    nValor1, nPeso1, nValor2, nPeso2, nPesoTotal

   nPesoTotal = nPeso1 + nPeso2

   IF nPesoTotal = 0 THEN
      RETURN(0)
   ENDIF

   RETURN(((nValor1 * nPeso1) + (nValor2 * nPeso2)) / nPesoTotal)

ENDFUNC

*************************
FUNCTION F_NumeroFatorial
*************************
PARAMETERS nValor
PRIVATE    nValor, nResultado, nIndice

   nResultado = 1

   FOR nIndice = 2 TO nValor
      nResultado = nResultado * nIndice
   ENDFOR

   RETURN(nResultado)

ENDFUNC

*************************
FUNCTION F_NumeroPotencia
*************************
PARAMETERS nBase, nExpoente
PRIVATE    nBase, nExpoente

   RETURN(nBase ^ nExpoente)

ENDFUNC

***************************
FUNCTION F_NumeroHipotenusa
***************************
PARAMETERS nCateto1, nCateto2
PRIVATE    nCateto1, nCateto2

   RETURN(SQRT((nCateto1 ^ 2) + (nCateto2 ^ 2)))

ENDFUNC

**************************
FUNCTION F_NumeroDistancia
**************************
PARAMETERS nX1, nY1, nX2, nY2
PRIVATE    nX1, nY1, nX2, nY2

   RETURN(SQRT(((nX2 - nX1) ^ 2) + ((nY2 - nY1) ^ 2)))

ENDFUNC

**************************
FUNCTION F_NumeroRegraTres
**************************
PARAMETERS nValor1, nValor2, nValor3
PRIVATE    nValor1, nValor2, nValor3

   IF nValor1 = 0 THEN
      RETURN(0)
   ENDIF

   RETURN((nValor2 * nValor3) / nValor1)

ENDFUNC

*****************************
FUNCTION F_NumeroJurosSimples
*****************************
PARAMETERS nCapital, nTaxa, nPeriodo
PRIVATE    nCapital, nTaxa, nPeriodo

   RETURN(nCapital * (nTaxa / 100) * nPeriodo)

ENDFUNC

*******************************
FUNCTION F_NumeroJurosCompostos
*******************************
PARAMETERS nCapital, nTaxa, nPeriodo
PRIVATE    nCapital, nTaxa, nPeriodo

   RETURN(nCapital * ((1 + (nTaxa / 100)) ^ nPeriodo))

ENDFUNC

************************
FUNCTION F_NumeroParcela
************************
PARAMETERS nValor, nQuantidade
PRIVATE    nValor, nQuantidade

   IF nQuantidade = 0 THEN
      RETURN(0)
   ENDIF

   RETURN(ROUND(nValor / nQuantidade, 2))

ENDFUNC

************************************
FUNCTION F_NumeroDiferencaPercentual
************************************
PARAMETERS nValorAnterior, nValorAtual
PRIVATE    nValorAnterior, nValorAtual

   IF nValorAnterior = 0 THEN
      RETURN(0)
   ENDIF

   RETURN(((nValorAtual - nValorAnterior) / nValorAnterior) * 100)

ENDFUNC

**************************
FUNCTION F_NumeroProporcao
**************************
PARAMETERS nParte, nTotal
PRIVATE    nParte, nTotal

   IF nTotal = 0 THEN
      RETURN(0)
   ENDIF

   RETURN(nParte / nTotal)

ENDFUNC

*******************
FUNCTION F_DataHoje
*******************
PRIVATE dHoje

   dHoje = DATE()

   RETURN(dHoje)

ENDFUNC

******************
FUNCTION F_DataAno
******************
PARAMETERS dData
PRIVATE    dData

   RETURN(YEAR(dData))

ENDFUNC

******************
FUNCTION F_DataMes
******************
PARAMETERS dData
PRIVATE    dData

   RETURN(MONTH(dData))

ENDFUNC

******************
FUNCTION F_DataDia
******************
PARAMETERS dData
PRIVATE    dData

   RETURN(DAY(dData))

ENDFUNC

************************
FUNCTION F_DataInicioMes
************************
PARAMETERS dData
PRIVATE    dData

   RETURN(DATE(YEAR(dData), MONTH(dData), 1))

ENDFUNC

*********************
FUNCTION F_DataFimMes
*********************
PARAMETERS dData
PRIVATE    dData

   RETURN(GOMONTH(DATE(YEAR(dData), MONTH(dData), 1), 1) - 1)

ENDFUNC

***************************
FUNCTION F_DataAdicionarMes
***************************
PARAMETERS dData, nQuantidade
PRIVATE    dData, nQuantidade

   RETURN(GOMONTH(dData, nQuantidade))

ENDFUNC

***************************
FUNCTION F_DataAdicionarDia
***************************
PARAMETERS dData, nQuantidade
PRIVATE    dData, nQuantidade

   RETURN(dData + nQuantidade)

ENDFUNC

***************************
FUNCTION F_DataDiferencaDia
***************************
PARAMETERS dDataInicial, dDataFinal
PRIVATE    dDataInicial, dDataFinal

   RETURN(dDataFinal - dDataInicial)

ENDFUNC

********************
FUNCTION F_DataIdade
********************
PARAMETERS dNascimento
PRIVATE    dNascimento, dHoje, nIdade

   dHoje  = DATE()
   nIdade = YEAR(dHoje) - YEAR(dNascimento)

   IF GOMONTH(dNascimento, nIdade * 12) > dHoje THEN
      nIdade = nIdade - 1
   ENDIF

   RETURN(nIdade)

ENDFUNC

**************************
FUNCTION F_DataAnoBissexto
**************************
PARAMETERS nAno
PRIVATE    nAno

   RETURN(MOD(nAno, 400) = 0 OR (MOD(nAno, 4) = 0 AND MOD(nAno, 100) <> 0))

ENDFUNC

************************
FUNCTION F_DataDiaSemana
************************
PARAMETERS dData
PRIVATE    dData

   RETURN(DOW(dData))

ENDFUNC

**********************
FUNCTION F_DataNomeMes
**********************
PARAMETERS dData
PRIVATE    dData

   RETURN(CMONTH(dData))

ENDFUNC

**********************
FUNCTION F_DataNomeDia
**********************
PARAMETERS dData
PRIVATE    dData

   RETURN(CDOW(dData))

ENDFUNC

****************************
FUNCTION F_DataFormatoBrasil
****************************
PARAMETERS dData
PRIVATE    dData

   RETURN(PADL(TRANSFORM(DAY(dData)), 2, "0") + "/" + ;
          PADL(TRANSFORM(MONTH(dData)), 2, "0") + "/" + ;
          TRANSFORM(YEAR(dData)))

ENDFUNC

**************************
FUNCTION F_DataCompetencia
**************************
PARAMETERS dData
PRIVATE    dData

   RETURN(PADL(TRANSFORM(MONTH(dData)), 2, "0") + "/" + TRANSFORM(YEAR(dData)))

ENDFUNC

************************
FUNCTION F_DataTrimestre
************************
PARAMETERS dData
PRIVATE    dData

   RETURN(INT((MONTH(dData) - 1) / 3) + 1)

ENDFUNC

***********************
FUNCTION F_DataSemestre
***********************
PARAMETERS dData
PRIVATE    dData

   RETURN(IIF(MONTH(dData) <= 6, 1, 2))

ENDFUNC

************************
FUNCTION F_DataFimSemana
************************
PARAMETERS dData
PRIVATE    dData, nDiaSemana

   nDiaSemana = DOW(dData, 2)

   RETURN(dData + (7 - nDiaSemana))

ENDFUNC

***************************
FUNCTION F_DataInicioSemana
***************************
PARAMETERS dData
PRIVATE    dData, nDiaSemana

   nDiaSemana = DOW(dData, 2)

   RETURN(dData - (nDiaSemana - 1))

ENDFUNC

**********************
FUNCTION F_MatrizSomar
**********************
PARAMETERS mValores
PRIVATE    mValores, nIndice, nTotal

   nTotal = 0

   FOR nIndice = 1 TO ALEN(mValores)
      nTotal = nTotal + mValores[nIndice]
   ENDFOR

   RETURN(nTotal)

ENDFUNC

**********************
FUNCTION F_MatrizMedia
**********************
PARAMETERS mValores
PRIVATE    mValores, nQuantidade

   nQuantidade = ALEN(mValores)

   IF nQuantidade = 0 THEN
      RETURN(0)
   ENDIF

   RETURN(F_MatrizSomar(@mValores) / nQuantidade)

ENDFUNC

**********************
FUNCTION F_MatrizMaior
**********************
PARAMETERS mValores
PRIVATE    mValores, nIndice, nMaior

   nMaior = mValores[1]

   FOR nIndice = 2 TO ALEN(mValores)

      IF mValores[nIndice] > nMaior THEN
         nMaior = mValores[nIndice]
      ENDIF

   ENDFOR

   RETURN(nMaior)

ENDFUNC

**********************
FUNCTION F_MatrizMenor
**********************
PARAMETERS mValores
PRIVATE    mValores, nIndice, nMenor

   nMenor = mValores[1]

   FOR nIndice = 2 TO ALEN(mValores)

      IF mValores[nIndice] < nMenor THEN
         nMenor = mValores[nIndice]
      ENDIF

   ENDFOR

   RETURN(nMenor)

ENDFUNC

************************
FUNCTION F_MatrizPosicao
************************
PARAMETERS mValores, uValor
PRIVATE    mValores, uValor, nIndice

   FOR nIndice = 1 TO ALEN(mValores)

      IF mValores[nIndice] = uValor THEN
         RETURN(nIndice)
      ENDIF

   ENDFOR

   RETURN(0)

ENDFUNC

***********************
FUNCTION F_MatrizConter
***********************
PARAMETERS mValores, uValor
PRIVATE    mValores, uValor

   RETURN(F_MatrizPosicao(@mValores, uValor) > 0)

ENDFUNC

*************************
PROCEDURE P_MatrizOrdenar
*************************
PARAMETERS mValores
PRIVATE    mValores

   ASORT(mValores)

   RETURN

ENDPROC

**************************
PROCEDURE P_MatrizInverter
**************************
PARAMETERS mValores
PRIVATE    mValores, uValor, nInicio, nFim

   nInicio = 1
   nFim    = ALEN(mValores)

   DO WHILE nInicio < nFim

      uValor            = mValores[nInicio]
      mValores[nInicio] = mValores[nFim]
      mValores[nFim]    = uValor

      nInicio = nInicio + 1
      nFim    = nFim - 1

   ENDDO

   RETURN

ENDPROC

****************************
FUNCTION F_MatrizTextoJuntar
****************************
PARAMETERS mValores, cSeparador
PRIVATE    mValores, cSeparador, cRetorno, nIndice

   cRetorno = ""

   FOR nIndice = 1 TO ALEN(mValores)

      IF nIndice > 1 THEN
         cRetorno = cRetorno + cSeparador
      ENDIF

      cRetorno = cRetorno + TRANSFORM(mValores[nIndice])

   ENDFOR

   RETURN(cRetorno)

ENDFUNC

**************************
FUNCTION F_MatrizDuplicado
**************************
PARAMETERS mValores
PRIVATE    mValores, nIndice1, nIndice2

   FOR nIndice1 = 1 TO ALEN(mValores) - 1

      FOR nIndice2 = nIndice1 + 1 TO ALEN(mValores)

         IF mValores[nIndice1] = mValores[nIndice2] THEN
            RETURN(.T.)
         ENDIF

      ENDFOR

   ENDFOR

   RETURN(.F.)

ENDFUNC

*********************************
FUNCTION F_MatrizNumeroQuantidade
*********************************
PARAMETERS mValores, nValor
PRIVATE    mValores, nValor, nIndice, nQuantidade

   nQuantidade = 0

   FOR nIndice = 1 TO ALEN(mValores)

      IF mValores[nIndice] = nValor THEN
         nQuantidade = nQuantidade + 1
      ENDIF

   ENDFOR

   RETURN(nQuantidade)

ENDFUNC

********************************
FUNCTION F_MatrizTextoQuantidade
********************************
PARAMETERS mValores, cValor
PRIVATE    mValores, cValor, nIndice, nQuantidade

   nQuantidade = 0

   FOR nIndice = 1 TO ALEN(mValores)

      IF mValores[nIndice] == cValor THEN
         nQuantidade = nQuantidade + 1
      ENDIF

   ENDFOR

   RETURN(nQuantidade)

ENDFUNC

******************************
PROCEDURE P_MatrizNumeroDobrar
******************************
PARAMETERS mValores
PRIVATE    mValores, nIndice

   FOR nIndice = 1 TO ALEN(mValores)
      mValores[nIndice] = mValores[nIndice] * 2
   ENDFOR

   RETURN

ENDPROC

*****************************
PROCEDURE P_MatrizTextoAparar
*****************************
PARAMETERS mValores
PRIVATE    mValores, nIndice

   FOR nIndice = 1 TO ALEN(mValores)
      mValores[nIndice] = ALLTRIM(mValores[nIndice])
   ENDFOR

   RETURN

ENDPROC

*******************************
FUNCTION F_MatrizNumeroPositivo
*******************************
PARAMETERS mValores
PRIVATE    mValores, nIndice

   FOR nIndice = 1 TO ALEN(mValores)

      IF mValores[nIndice] <= 0 THEN
         RETURN(.F.)
      ENDIF

   ENDFOR

   RETURN(.T.)

ENDFUNC

*******************************
FUNCTION F_MatrizNumeroNegativo
*******************************
PARAMETERS mValores
PRIVATE    mValores, nIndice

   FOR nIndice = 1 TO ALEN(mValores)

      IF mValores[nIndice] >= 0 THEN
         RETURN(.F.)
      ENDIF

   ENDFOR

   RETURN(.T.)

ENDFUNC

******************************
FUNCTION F_MatrizNumeroProduto
******************************
PARAMETERS mValores
PRIVATE    mValores, nIndice, nProduto

   nProduto = 1

   FOR nIndice = 1 TO ALEN(mValores)
      nProduto = nProduto * mValores[nIndice]
   ENDFOR

   RETURN(nProduto)

ENDFUNC

********************************
FUNCTION F_MatrizNumeroAmplitude
********************************
PARAMETERS mValores
PRIVATE    mValores

   RETURN(F_MatrizMaior(@mValores) - F_MatrizMenor(@mValores))

ENDFUNC

***************************
FUNCTION F_MatrizTextoVazio
***************************
PARAMETERS mValores
PRIVATE    mValores, nIndice

   FOR nIndice = 1 TO ALEN(mValores)

      IF NOT EMPTY(ALLTRIM(mValores[nIndice])) THEN
         RETURN(.F.)
      ENDIF

   ENDFOR

   RETURN(.T.)

ENDFUNC

*******************************
FUNCTION F_MatrizTextoMaiusculo
*******************************
PARAMETERS mValores
PRIVATE    mValores, nIndice

   FOR nIndice = 1 TO ALEN(mValores)
      mValores[nIndice] = UPPER(mValores[nIndice])
   ENDFOR

   RETURN(.T.)

ENDFUNC

******************************
PROCEDURE P_ClienteCursorCriar
******************************
PRIVATE CursorCliente

   CREATE CURSOR CursorCliente (nCodigo  I, ;
                                cNome    C(100), ;
                                cEmail   C(120), ;
                                lAtivo   L)

   RETURN

ENDPROC

******************************
PROCEDURE P_ProdutoCursorCriar
******************************
PRIVATE CursorProduto

   CREATE CURSOR CursorProduto (nCodigo     Integer, ;
                                cDescricao  Character(120), ;
                                nQuantidade Numeric(12, 3), ;
                                nValor      Numeric(14, 2))

   RETURN

ENDPROC

*******************************
PROCEDURE P_ClienteCursorLimpar
*******************************
PRIVATE CursorCliente

   SELECT CursorCliente
   ZAP

   RETURN

ENDPROC

************************
FUNCTION F_ClienteBuscar
************************
PARAMETERS nCodigo
PRIVATE    nCodigo, lEncontrado

   SELECT Cliente
   SET ORDER TO TAG Codigo
   lEncontrado = SEEK(nCodigo, "Cliente", "Codigo")

   RETURN(lEncontrado)

ENDFUNC

************************
FUNCTION F_ProdutoBuscar
************************
PARAMETERS nCodigo
PRIVATE    nCodigo, lEncontrado

   SELECT Produto
   SET ORDER TO TAG Codigo
   lEncontrado = SEEK(nCodigo, "Produto", "Codigo")

   RETURN(lEncontrado)

ENDFUNC

****************************
FUNCTION F_ClienteNomeBuscar
****************************
PARAMETERS cNome
PRIVATE    cNome, lEncontrado

   SELECT Cliente
   LOCATE FOR UPPER(ALLTRIM(Cliente.Nome)) == UPPER(ALLTRIM(cNome))
   lEncontrado = FOUND()

   RETURN(lEncontrado)

ENDFUNC

***********************
FUNCTION F_ProdutoSaldo
***********************
PARAMETERS nCodigo
PRIVATE    nCodigo, nSaldo

   SELECT Produto
   SET ORDER TO TAG Codigo

   IF SEEK(nCodigo, "Produto", "Codigo") THEN

      nSaldo = Produto.Quantidade

   ELSE

      nSaldo = 0

   ENDIF

   RETURN(nSaldo)

ENDFUNC

*************************
FUNCTION F_ClienteInserir
*************************
PARAMETERS nCodigo, cNome, cEmail
PRIVATE    nCodigo, cNome, cEmail

   INSERT INTO Cliente ;
               (Codigo, ;
                Nome, ;
                Email, ;
                Ativo) ;
        VALUES (nCodigo, ;
                ALLTRIM(cNome), ;
                LOWER(ALLTRIM(cEmail)), ;
                .T.)

   RETURN(_TALLY = 1)

ENDFUNC

*************************
FUNCTION F_ProdutoInserir
*************************
PARAMETERS nCodigo, cDescricao, nQuantidade, nValor
PRIVATE    nCodigo, cDescricao, nQuantidade, nValor

   INSERT INTO Produto ;
               (Codigo, ;
                Descricao, ;
                Quantidade, ;
                Valor) ;
        VALUES (nCodigo, ;
                ALLTRIM(cDescricao), ;
                nQuantidade, ;
                nValor)

   RETURN(_TALLY = 1)

ENDFUNC

***************************
FUNCTION F_ClienteAtualizar
***************************
PARAMETERS nCodigo, cNome, cEmail
PRIVATE    nCodigo, cNome, cEmail

   UPDATE Cliente ;
   SET Nome  = ALLTRIM(cNome), ;
       Email = LOWER(ALLTRIM(cEmail)) ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

***************************
FUNCTION F_ProdutoAtualizar
***************************
PARAMETERS nCodigo, cDescricao, nQuantidade, nValor
PRIVATE    nCodigo, cDescricao, nQuantidade, nValor

   UPDATE Produto ;
   SET Descricao  = ALLTRIM(cDescricao), ;
       Quantidade = nQuantidade, ;
       Valor      = nValor ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

***************************
FUNCTION F_ClienteDesativar
***************************
PARAMETERS nCodigo
PRIVATE    nCodigo

   UPDATE Cliente ;
   SET Ativo = .F. ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

************************
FUNCTION F_ClienteAtivar
************************
PARAMETERS nCodigo
PRIVATE    nCodigo

   UPDATE Cliente ;
   SET Ativo = .T. ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

**********************************
FUNCTION F_ProdutoEstoqueAdicionar
**********************************
PARAMETERS nCodigo, nQuantidade
PRIVATE    nCodigo, nQuantidade

   UPDATE Produto ;
   SET Quantidade = Quantidade + nQuantidade ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

********************************
FUNCTION F_ProdutoEstoqueRetirar
********************************
PARAMETERS nCodigo, nQuantidade
PRIVATE    nCodigo, nQuantidade

   UPDATE Produto ;
   SET Quantidade = Quantidade - nQuantidade ;
   WHERE Codigo = nCodigo AND ;
       Quantidade >= nQuantidade

   RETURN(_TALLY = 1)

ENDFUNC

*************************
FUNCTION F_ClienteExcluir
*************************
PARAMETERS nCodigo
PRIVATE    nCodigo

   DELETE FROM Cliente ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

*************************
FUNCTION F_ProdutoExcluir
*************************
PARAMETERS nCodigo
PRIVATE    nCodigo

   DELETE FROM Produto ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

******************************
PROCEDURE P_ClienteAtivoCursor
******************************
PRIVATE CursorClienteAtivo

   SELECT Codigo, ;
          Nome, ;
          Email ;
   FROM Cliente ;
   WHERE Ativo ;
   ORDER BY Nome ;
   INTO CURSOR CursorClienteAtivo READWRITE

   RETURN

ENDPROC

********************************
PROCEDURE P_ProdutoEstoqueCursor
********************************
PRIVATE CursorProdutoEstoque

   SELECT Codigo, ;
          Descricao, ;
          Quantidade, ;
          Valor ;
   FROM Produto ;
   WHERE Quantidade > 0 ;
   ORDER BY Descricao ;
   INTO CURSOR CursorProdutoEstoque READWRITE

   RETURN

ENDPROC

******************************
PROCEDURE P_ProdutoFaltaCursor
******************************
PARAMETERS nMinimo
PRIVATE    nMinimo, CursorProdutoFalta

   SELECT Codigo, ;
          Descricao, ;
          Quantidade ;
   FROM Produto ;
   WHERE Quantidade <= nMinimo ;
   ORDER BY Quantidade, Descricao ;
   INTO CURSOR CursorProdutoFalta READWRITE

   RETURN

ENDPROC

******************************
PROCEDURE P_VendaPeriodoCursor
******************************
PARAMETERS dInicial, dFinal
PRIVATE    dInicial, dFinal, CursorVendaPeriodo

   SELECT Codigo, ;
          ClienteCodigo, ;
          Data, ;
          Valor ;
   FROM Venda ;
   WHERE Data BETWEEN dInicial AND dFinal ;
   ORDER BY Data ;
   INTO CURSOR CursorVendaPeriodo READWRITE

   RETURN

ENDPROC

******************************
PROCEDURE P_VendaClienteCursor
******************************
PARAMETERS nClienteCodigo
PRIVATE    nClienteCodigo, CursorVendaCliente

   SELECT Codigo, ;
          Data, ;
          Valor ;
   FROM Venda ;
   WHERE ClienteCodigo = nClienteCodigo ;
   ORDER BY Data DESC ;
   INTO CURSOR CursorVendaCliente READWRITE

   RETURN

ENDPROC

******************************
PROCEDURE P_ClienteVendaCursor
******************************
PRIVATE CursorClienteVenda

   SELECT Cliente.Codigo, ;
          Cliente.Nome, ;
          COUNT(Venda.Codigo) AS VendaQuantidade, ;
          NVL(SUM(Venda.Valor), 0) AS VendaValor ;
   FROM Cliente ;
      LEFT JOIN Venda ON (Venda.ClienteCodigo = Cliente.Codigo) ;
   GROUP BY Cliente.Codigo, Cliente.Nome ;
   ORDER BY VendaValor DESC ;
   INTO CURSOR CursorClienteVenda READWRITE

   RETURN

ENDPROC

******************************
PROCEDURE P_ProdutoVendaCursor
******************************
PRIVATE CursorProdutoVenda

   SELECT Produto.Codigo, ;
          Produto.Descricao, ;
          NVL(SUM(VendaItem.Quantidade), 0) AS VendaQuantidade, ;
          NVL(SUM(VendaItem.Total), 0) AS VendaValor ;
   FROM Produto ;
      LEFT JOIN VendaItem ON (VendaItem.ProdutoCodigo = Produto.Codigo) ;
   GROUP BY Produto.Codigo, Produto.Descricao ;
   ORDER BY VendaQuantidade DESC ;
   INTO CURSOR CursorProdutoVenda READWRITE

   RETURN

ENDPROC

*********************
FUNCTION F_VendaTotal
*********************
PARAMETERS nVendaCodigo
PRIVATE    nVendaCodigo, nTotal

   SELECT SUM(Total) AS Total ;
   FROM VendaItem ;
   WHERE VendaCodigo = nVendaCodigo ;
   INTO CURSOR CursorVendaTotal

   nTotal = NVL(CursorVendaTotal.Total, 0)

   USE IN CursorVendaTotal

   RETURN(nTotal)

ENDFUNC

****************************
FUNCTION F_ClienteVendaTotal
****************************
PARAMETERS nClienteCodigo
PRIVATE    nClienteCodigo, nTotal

   SELECT SUM(Valor) AS Total ;
   FROM Venda ;
   WHERE ClienteCodigo = nClienteCodigo ;
   INTO CURSOR CursorClienteTotal

   nTotal = NVL(CursorClienteTotal.Total, 0)

   USE IN CursorClienteTotal

   RETURN(nTotal)

ENDFUNC

*********************************
FUNCTION F_ProdutoQuantidadeTotal
*********************************
PRIVATE nTotal

   SELECT SUM(Quantidade) AS Total ;
   FROM Produto ;
   INTO CURSOR CursorProdutoTotal

   nTotal = NVL(CursorProdutoTotal.Total, 0)

   USE IN CursorProdutoTotal

   RETURN(nTotal)

ENDFUNC

****************************
FUNCTION F_ClienteQuantidade
****************************
PRIVATE nQuantidade

   SELECT COUNT(*) AS Quantidade ;
   FROM Cliente ;
   INTO CURSOR CursorClienteQuantidade

   nQuantidade = CursorClienteQuantidade.Quantidade

   USE IN CursorClienteQuantidade

   RETURN(nQuantidade)

ENDFUNC

*********************************
FUNCTION F_ClienteAtivoQuantidade
*********************************
PRIVATE nQuantidade

   SELECT COUNT(*) AS Quantidade ;
   FROM Cliente ;
   WHERE Ativo ;
   INTO CURSOR CursorClienteQuantidade

   nQuantidade = CursorClienteQuantidade.Quantidade

   USE IN CursorClienteQuantidade

   RETURN(nQuantidade)

ENDFUNC

**********************************
PROCEDURE P_ClienteEmailNormalizar
**********************************
PRIVATE nArea

   nArea = SELECT()

   SELECT Cliente
   SCAN
      REPLACE Email WITH LOWER(ALLTRIM(Cliente.Email))
   ENDSCAN

   SELECT (nArea)

   RETURN

ENDPROC

*********************************
PROCEDURE P_ClienteNomeNormalizar
*********************************
PRIVATE nArea

   nArea = SELECT()

   SELECT Cliente
   SCAN
      REPLACE Nome WITH PROPER(LOWER(ALLTRIM(Cliente.Nome)))
   ENDSCAN

   SELECT (nArea)

   RETURN

ENDPROC

**************************************
PROCEDURE P_ProdutoDescricaoNormalizar
**************************************
PRIVATE nArea

   nArea = SELECT()

   SELECT Produto
   SCAN
      REPLACE Descricao WITH ALLTRIM(Produto.Descricao)
   ENDSCAN

   SELECT (nArea)

   RETURN

ENDPROC

*********************************
PROCEDURE P_ProdutoValorReajustar
*********************************
PARAMETERS nPercentual
PRIVATE    nPercentual

   UPDATE Produto ;
   SET Valor = ROUND(Valor * (1 + (nPercentual / 100)), 2)

   RETURN

ENDPROC

***********************************
PROCEDURE P_VendaItemTotalAtualizar
***********************************
PRIVATE nArea

   nArea = SELECT()

   SELECT VendaItem
   SCAN
      REPLACE Total WITH ROUND(VendaItem.Quantidade * VendaItem.Valor, 2)
   ENDSCAN

   SELECT (nArea)

   RETURN

ENDPROC

**************************
FUNCTION F_VendaRecalcular
**************************
PARAMETERS nVendaCodigo
PRIVATE    nVendaCodigo, nTotal

   nTotal = F_VendaTotal(nVendaCodigo)

   UPDATE Venda ;
   SET Valor = nTotal ;
   WHERE Codigo = nVendaCodigo

   RETURN(_TALLY = 1)

ENDFUNC

********************************
PROCEDURE P_VendaRecalcularTodas
********************************
PRIVATE nArea, nVendaCodigo

   nArea = SELECT()

   SELECT Venda
   SCAN

      nVendaCodigo = Venda.Codigo

      REPLACE Valor WITH F_VendaTotal(nVendaCodigo)

   ENDSCAN

   SELECT (nArea)

   RETURN

ENDPROC

**************************
FUNCTION F_ClienteBloquear
**************************
PARAMETERS nCodigo, cMotivo
PRIVATE    nCodigo, cMotivo

   UPDATE Cliente ;
   SET Bloqueado      = .T., ;
       BloqueioMotivo = ALLTRIM(cMotivo), ;
       BloqueioData   = DATETIME() ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

*****************************
FUNCTION F_ClienteDesbloquear
*****************************
PARAMETERS nCodigo
PRIVATE    nCodigo

   UPDATE Cliente ;
   SET Bloqueado      = .F., ;
       BloqueioMotivo = "", ;
       BloqueioData   = {} ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC

*********************************
PROCEDURE P_ClientePesquisaCursor
*********************************
PARAMETERS cPesquisa
PRIVATE    cPesquisa, CursorClientePesquisa

   cPesquisa = "%" + UPPER(ALLTRIM(cPesquisa)) + "%"

   SELECT Codigo, ;
          Nome, ;
          Email ;
   FROM Cliente ;
   WHERE UPPER(Nome) LIKE cPesquisa OR ;
       UPPER(Email) LIKE cPesquisa ;
   ORDER BY Nome ;
   INTO CURSOR CursorClientePesquisa READWRITE

   RETURN

ENDPROC

*********************************
PROCEDURE P_ProdutoPesquisaCursor
*********************************
PARAMETERS cPesquisa
PRIVATE    cPesquisa, CursorProdutoPesquisa

   cPesquisa = "%" + UPPER(ALLTRIM(cPesquisa)) + "%"

   SELECT Codigo, ;
          Descricao, ;
          Quantidade, ;
          Valor ;
   FROM Produto ;
   WHERE UPPER(Descricao) LIKE cPesquisa ;
   ORDER BY Descricao ;
   INTO CURSOR CursorProdutoPesquisa READWRITE

   RETURN

ENDPROC

**********************
FUNCTION F_CursorAbrir
**********************
PARAMETERS cArquivo, cAlias
PRIVATE    cArquivo, cAlias

   USE (cArquivo) IN 0 SHARED ALIAS (cAlias)

   RETURN(USED(cAlias))

ENDFUNC

************************
PROCEDURE P_CursorFechar
************************
PARAMETERS cAlias
PRIVATE    cAlias

   IF USED(cAlias) THEN
      USE IN SELECT(cAlias)
   ENDIF

   RETURN

ENDPROC

**************************
PROCEDURE P_CursorPrimeiro
**************************
PARAMETERS cAlias
PRIVATE    cAlias

   SELECT (cAlias)
   GO TOP

   RETURN

ENDPROC

************************
PROCEDURE P_CursorUltimo
************************
PARAMETERS cAlias
PRIVATE    cAlias

   SELECT (cAlias)
   GO BOTTOM

   RETURN

ENDPROC

