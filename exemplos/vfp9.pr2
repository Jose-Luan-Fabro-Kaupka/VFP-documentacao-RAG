PRIVATE    cAlias, nQuantidade

   nQuantidade = RECCOUNT(cAlias)

   RETURN(nQuantidade)

ENDFUNC

**********************
FUNCTION F_CursorVazio
**********************
PARAMETERS cAlias
PRIVATE    cAlias

   RETURN(RECCOUNT(cAlias) = 0)

ENDFUNC

