**Erro de sintaxe, GROUP BY escrito como GROUP BYY

*******************************
PROCEDURE P_ClientesResumoGerar
*******************************

   IF USED("curResumoClientes") THEN
      USE IN curResumoClientes
   ENDIF

   SELECT Clientes.Id, ;
          Clientes.Nome, ;
          COUNT(Vendas.Id) AS QuantidadeVendas, ;
          NVL(SUM(Vendas.ValorTotal), 0) AS TotalVendido ;
   FROM Clientes ;
      LEFT JOIN Vendas ON (Vendas.ClienteId = Clientes.Id) ;
   GROUP BYY Clientes.Id, Clientes.Nome ;
   ORDER BY TotalVendido DESC ;
   INTO CURSOR curResumoClientes READWRITE

ENDPROC


**Erro de lógica, NVL trocado por EVL

*******************************
PROCEDURE P_ClientesResumoGerar
*******************************

   IF USED("curResumoClientes") THEN
      USE IN curResumoClientes
   ENDIF

   SELECT Clientes.Id, ;
          Clientes.Nome, ;
          COUNT(Vendas.Id) AS QuantidadeVendas, ;
          EVL(SUM(Vendas.ValorTotal), 0) AS TotalVendido ;
   FROM Clientes ;
      LEFT JOIN Vendas ON (Vendas.ClienteId = Clientes.Id) ;
   GROUP BY Clientes.Id, Clientes.Nome ;
   ORDER BY TotalVendido DESC ;
   INTO CURSOR curResumoClientes READWRITE

ENDPROC


**Erro de sintaxe, INTO CURSOR escrito como INTO CURSR

*****************************
PROCEDURE P_ClientesPesquisar
*****************************
PARAMETERS cNomePesquisa
PRIVATE    cNomePesquisa, cPesquisa

   cPesquisa = "%" + UPPER(ALLTRIM(cNomePesquisa)) + "%"

   IF USED("curClientes") THEN
      USE IN curClientes
   ENDIF

   SELECT Id, ;
          Nome, ;
          Email ;
   FROM Clientes ;
   WHERE UPPER(Nome) LIKE cPesquisa ;
   ORDER BY Nome ;
   INTO CURSR curClientes READWRITE

   RETURN

ENDPROC


