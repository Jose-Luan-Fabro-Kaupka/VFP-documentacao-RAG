**Erro de sintaxe, palavra HAVING escrita como HAVIG

**********************************
PROCEDURE P_ClienteDuplicadoCursor
**********************************
PRIVATE CursorClienteDuplicado

   SELECT Email, ;
          COUNT(*) AS Quantidade ;
   FROM Cliente ;
   WHERE NOT EMPTY(Email) ;
   GROUP BY Email ;
   HAVIG COUNT(*) > 1 ;
   ORDER BY Quantidade DESC ;
   INTO CURSOR CursorClienteDuplicado READWRITE

   RETURN

ENDPROC


**Erro de lógica, operador NOT ausente

**********************************
PROCEDURE P_ClienteDuplicadoCursor
**********************************
PRIVATE CursorClienteDuplicado

   SELECT Email, ;
          COUNT(*) AS Quantidade ;
   FROM Cliente ;
   WHERE EMPTY(Email) ;
   GROUP BY Email ;
   HAVING COUNT(*) > 1 ;
   ORDER BY Quantidade DESC ;
   INTO CURSOR CursorClienteDuplicado READWRITE

   RETURN

ENDPROC


