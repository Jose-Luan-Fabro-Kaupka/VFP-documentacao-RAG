**Erro de lógica, operador '+' trocado por '-'

*********************************
FUNCTION F_MatrizNumeroQuantidade
*********************************
PARAMETERS mValores, nValor
PRIVATE    mValores, nValor, nIndice, nQuantidade

   nQuantidade = 0

   FOR nIndice = 1 TO ALEN(mValores)

      IF mValores[nIndice] = nValor THEN
         nQuantidade = nQuantidade -  1
      ENDIF

   ENDFOR

   RETURN(nQuantidade)

ENDFUNC


