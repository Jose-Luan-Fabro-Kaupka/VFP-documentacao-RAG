   TRY
      IF NOT USED("Clientes") THEN
         USE Clientes IN 0 SHARED ALIAS Clientes
      ENDIF

      lSucesso = USED("Clientes")

   CATCH TO oErro
      MESSAGEBOX( ;
         "Não foi possível abrir a tabela de clientes." + CHAR(13) + ;
         oErro.Message, ;
         16, ;
         "Erro" ;
      )

      lSucesso = .F.
   ENDTRY

   RETURN(lSucesso)

ENDFUNC


**Erro de sintaxe, TABLEUPDATE escrito como TABLEUPDAET

***********************************
FUNCTION F_ClientesAlteracoesSalvar
***********************************
PRIVATE ARRAY aErros[1], lSucesso, oErro

   lSucesso = .F.
   oErro    = .NULL.

   IF NOT USED("Clientes") THEN
      RETURN(.F.)
   ENDIF

   BEGIN TRANSACTION

   TRY

      SELECT Clientes

      IF TABLEUPDAET(.T., .F., "Clientes") THEN

         END TRANSACTION

         lSucesso = .T.

      ELSE

         ROLLBACK

         AERROR(aErros)

         MESSAGEBOX( ;
            "Não foi possível salvar as alterações: " + ;
            TRANSFORM(aErros[1, 2]), ;
            16, ;
            "Erro de atualização" ;
         )

      ENDIF

   CATCH TO oErro

      ROLLBACK

      MESSAGEBOX( ;
         oErro.Message, ;
         16, ;
         "Erro durante a transação" ;
      )

      lSucesso = .F.

   ENDTRY

   RETURN(lSucesso)

ENDFUNC


**Erro de lógica, MESSAGEBOX trocado por WAIT

***********************************
FUNCTION F_ClientesAlteracoesSalvar
***********************************
PRIVATE ARRAY aErros[1], lSucesso, oErro

   lSucesso = .F.
   oErro    = .NULL.

   IF NOT USED("Clientes") THEN
      RETURN(.F.)
   ENDIF

   BEGIN TRANSACTION

   TRY

      SELECT Clientes

      IF TABLEUPDATE(.T., .F., "Clientes") THEN

         END TRANSACTION

         lSucesso = .T.

      ELSE

         ROLLBACK

         AERROR(aErros)

         WAIT( ;
            "Não foi possível salvar as alterações: " + ;
            TRANSFORM(aErros[1, 2]), ;
            16, ;
            "Erro de atualização" ;
         )

      ENDIF

   CATCH TO oErro

      ROLLBACK

      MESSAGEBOX( ;
         oErro.Message, ;
         16, ;
         "Erro durante a transação" ;
      )

      lSucesso = .F.

   ENDTRY

   RETURN(lSucesso)

ENDFUNC


