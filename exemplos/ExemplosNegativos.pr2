**Erro de sintaxe, índice de matriz com '()' no lugar de '[]'

**********************
FUNCTION F_MatrizSomar
**********************
PARAMETERS mValores
PRIVATE    mValores, nIndice, nTotal

   nTotal = 0

   FOR nIndice = 1 TO ALEN(mValores)
      nTotal = nTotal + mValores(nIndice)
   ENDFOR

   RETURN(nTotal)

ENDFUNC


