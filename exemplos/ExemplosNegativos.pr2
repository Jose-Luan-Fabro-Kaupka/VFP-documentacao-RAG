**Erro de sintaxe, palavra TO escrita como TOO no FOR

************************
FUNCTION F_TextoInverter
************************
PARAMETERS cTexto
PRIVATE    cTexto, cRetorno, nIndice

   cRetorno = ""

   FOR nIndice = LEN(cTexto) TOO 1 STEP -1
      cRetorno = cRetorno + SUBSTR(cTexto, nIndice, 1)
   ENDFOR

   RETURN(cRetorno)

ENDFUNC


