**Erro de sintaxe, CLEAR DLLS escrito como CLEAR DLL

**************************
FUNCTION F_ConfiguracaoLer
**************************
PARAMETERS cArquivo, cSecao, cChave
PRIVATE    cArquivo, cSecao, cChave, cValor

   cValor = SPACE(1024)

   DECLARE INTEGER GetPrivateProfileString IN Win32API ;
      STRING cSecao, STRING cChave, STRING cPadrao, ;
      STRING @cValor, INTEGER nTamanho, STRING cArquivo

   GetPrivateProfileString(cSecao, cChave, "", @cValor, LEN(cValor), cArquivo)

   CLEAR DLL GetPrivateProfileString

   RETURN(LEFT(cValor, AT(CHR(0), cValor) - 1))

ENDFUNC


