      cCaractere = SUBSTR(cTexto, nIndice, 1)

      IF AT(UPPER(cCaractere), "ABCDEFGHIJKLMNOPQRSTUVWXYZ") > 0 THEN
         cRetorno = cRetorno + cCaractere
