**Erro de lógica, DATETIME trocado por DATE

**************************
FUNCTION F_ClienteBloquear
**************************
PARAMETERS nCodigo, cMotivo
PRIVATE    nCodigo, cMotivo

   UPDATE Cliente ;
   SET Bloqueado      = .T., ;
       BloqueioMotivo = ALLTRIM(cMotivo), ;
       BloqueioData   = DATE() ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC


**Erro de sintaxe, palavra UPDATE escrita como UPDAET

**************************
FUNCTION F_ClienteBloquear
**************************
PARAMETERS nCodigo, cMotivo
PRIVATE    nCodigo, cMotivo

   UPDAET Cliente ;
   SET Bloqueado      = .T., ;
       BloqueioMotivo = ALLTRIM(cMotivo), ;
       BloqueioData   = DATETIME() ;
   WHERE Codigo = nCodigo

   RETURN(_TALLY = 1)

ENDFUNC


