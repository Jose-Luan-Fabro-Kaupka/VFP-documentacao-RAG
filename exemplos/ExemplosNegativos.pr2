PROCEDURE P_ProdutoVendaCursor
******************************
PRIVATE CursorProdutoVenda

   SELECT Produto.Codigo, ;
          Produto.Descricao, ;
          NVL(SUM(VendaItem.Quantidade), 0) AS VendaQuantidade, ;
          NVL(SUM(VendaItem.Total), 0) AS VendaValor ;
   FROM Produto ;
      LEFT JOIN VendaItem ON (VendaItem.ProdutoCodigo == Produto.Codigo) ;
   GROUP BY Produto.Codigo, Produto.Descricao ;
   ORDER BY VendaQuantidade DESC ;
   INTO CURSOR CursorProdutoVenda READWRITE

   RETURN

ENDPROC


**Erro de lógica, NVL trocado por EVL

******************************
PROCEDURE P_ProdutoVendaCursor
******************************
PRIVATE CursorProdutoVenda

   SELECT Produto.Codigo, ;
          Produto.Descricao, ;
          EVL(SUM(VendaItem.Quantidade), 0) AS VendaQuantidade, ;
          NVL(SUM(VendaItem.Total), 0) AS VendaValor ;
   FROM Produto ;
      LEFT JOIN VendaItem ON (VendaItem.ProdutoCodigo = Produto.Codigo) ;
   GROUP BY Produto.Codigo, Produto.Descricao ;
   ORDER BY VendaQuantidade DESC ;
   INTO CURSOR CursorProdutoVenda READWRITE

   RETURN

ENDPROC


**Erro de sintaxe, USE IN escrito como USE ON

*********************
FUNCTION F_VendaTotal
*********************
PARAMETERS nVendaCodigo
PRIVATE    nVendaCodigo, nTotal

   SELECT SUM(Total) AS Total ;
   FROM VendaItem ;
   WHERE VendaCodigo = nVendaCodigo ;
   INTO CURSOR CursorVendaTotal

   nTotal = NVL(CursorVendaTotal.Total, 0)

   USE ON CursorVendaTotal

   RETURN(nTotal)

ENDFUNC


