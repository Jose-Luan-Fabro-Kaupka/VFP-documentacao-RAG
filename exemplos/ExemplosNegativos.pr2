**Erro de sintaxe, operador LIKE escrito como LIK

*********************************
PROCEDURE P_ClientePesquisaCursor
*********************************
PARAMETERS cPesquisa
PRIVATE    cPesquisa, CursorClientePesquisa

   cPesquisa = "%" + UPPER(ALLTRIM(cPesquisa)) + "%"

   SELECT Codigo, ;
          Nome, ;
          Email ;
   FROM Cliente ;
   WHERE UPPER(Nome) LIK cPesquisa OR ;
       UPPER(Email) LIKE cPesquisa ;
   ORDER BY Nome ;
   INTO CURSOR CursorClientePesquisa READWRITE

   RETURN

ENDPROC


**Erro de lógica, operador OR trocado por AND

*********************************
PROCEDURE P_ClientePesquisaCursor
*********************************
PARAMETERS cPesquisa
PRIVATE    cPesquisa, CursorClientePesquisa

   cPesquisa = "%" + UPPER(ALLTRIM(cPesquisa)) + "%"

   SELECT Codigo, ;
          Nome, ;
          Email ;
   FROM Cliente ;
   WHERE UPPER(Nome) LIKE cPesquisa AND ;
       UPPER(Email) LIKE cPesquisa ;
   ORDER BY Nome ;
   INTO CURSOR CursorClientePesquisa READWRITE

   RETURN

ENDPROC


