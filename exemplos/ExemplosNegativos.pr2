   nIdade = YEAR(dHoje) - YEAR(dNascimento)

   IF GOMONTH(dNascimento, nIdade * 12) > dHoje THEN
      nIdade = nIdade - 1
   ENDIF

   RETURN(nIdade)

ENDFUNC


