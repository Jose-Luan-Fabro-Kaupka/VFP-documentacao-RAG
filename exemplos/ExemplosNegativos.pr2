**Erro de sintaxe, LOCATE escrito como LOACTE

***************************
FUNCTION F_ClienteAtualizar
***************************
PARAMETERS nClienteId, oDados
PRIVATE    nClienteId, oDados, lAtualizado, nAreaAnterior, oCliente

   lAtualizado   = .F.
   nAreaAnterior = SELECT()
   oCliente      = .NULL.

   IF NOT USED("Clientes") THEN
      RETURN(.F.)
   ENDIF

   SELECT Clientes

   LOACTE FOR Clientes.Id = nClienteId

   IF FOUND() THEN

      SCATTER NAME oCliente MEMO

      IF PEMSTATUS(oDados, "Nome", 5) THEN
         oCliente.Nome = ALLTRIM(oDados.Nome)
      ENDIF

      IF PEMSTATUS(oDados, "Email", 5) THEN
         oCliente.Email = LOWER(ALLTRIM(oDados.Email))
      ENDIF

      GATHER NAME oCliente MEMO

      lAtualizado = .T.

   ENDIF

   SELECT (nAreaAnterior)

   RETURN(lAtualizado)

ENDFUNC


**Erro de lógica, PEMSTATUS trocado por GETPEM

***************************
FUNCTION F_ClienteAtualizar
***************************
PARAMETERS nClienteId, oDados
PRIVATE    nClienteId, oDados, lAtualizado, nAreaAnterior, oCliente

   lAtualizado   = .F.
   nAreaAnterior = SELECT()
   oCliente      = .NULL.

   IF NOT USED("Clientes") THEN
      RETURN(.F.)
   ENDIF

   SELECT Clientes

   LOCATE FOR Clientes.Id = nClienteId

   IF FOUND() THEN

      SCATTER NAME oCliente MEMO

      IF GETPEM(oDados, "Nome", 5) THEN
         oCliente.Nome = ALLTRIM(oDados.Nome)
      ENDIF

      IF PEMSTATUS(oDados, "Email", 5) THEN
         oCliente.Email = LOWER(ALLTRIM(oDados.Email))
      ENDIF

      GATHER NAME oCliente MEMO

      lAtualizado = .T.

   ENDIF

   SELECT (nAreaAnterior)

   RETURN(lAtualizado)

ENDFUNC


**Erro de sintaxe, comentário inserido entre linhas continuadas com ';'

******************************
FUNCTION F_TabelaClientesAbrir
******************************
PRIVATE lSucesso, oErro

   lSucesso = .F.
   oErro    = .NULL.

   TRY
      IF NOT USED("Clientes") THEN
         USE Clientes IN 0 SHARED ALIAS Clientes
      ENDIF

      lSucesso = USED("Clientes")

   CATCH TO oErro
      MESSAGEBOX( ;
&& quebra inválida entre continuação
         "Não foi possível abrir a tabela de clientes." + CHR(13) + ;
         oErro.Message, ;
         16, ;
         "Erro" ;
      )

      lSucesso = .F.
   ENDTRY

   RETURN(lSucesso)

ENDFUNC


**Erro de lógica, CHR trocado por CHAR

