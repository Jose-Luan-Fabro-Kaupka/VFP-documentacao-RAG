**Erro de lógica, YEAR trocado por MONTH

********************
FUNCTION F_DataIdade
********************
PARAMETERS dNascimento
PRIVATE    dNascimento, dHoje, nIdade

   dHoje  = DATE()
   nIdade = MONTH(dHoje) - YEAR(dNascimento)

   IF GOMONTH(dNascimento, nIdade * 12) > dHoje THEN
      nIdade = nIdade - 1
   ENDIF

   RETURN(nIdade)

ENDFUNC


