**Erro de sintaxe, palavra ELSE escrita como ELS

***********************
FUNCTION F_ProdutoSaldo
***********************
PARAMETERS nCodigo
PRIVATE    nCodigo, nSaldo

   SELECT Produto
   SET ORDER TO TAG Codigo

   IF SEEK(nCodigo, "Produto", "Codigo") THEN

      nSaldo = Produto.Quantidade

   ELS
      nSaldo = 0

   ENDIF

   RETURN(nSaldo)

ENDFUNC


