**Erro de sintaxe, palavra TO escrita como TOO no FOR

*****************************
FUNCTION F_TextoNumerosManter
*****************************
PARAMETERS cTexto
PRIVATE    cTexto, cRetorno, cCaractere, nIndice

   cRetorno = ""

   FOR nIndice = 1 TOO LEN(cTexto)

      cCaractere = SUBSTR(cTexto, nIndice, 1)

      IF AT(cCaractere, "0123456789") > 0 THEN
         cRetorno = cRetorno + cCaractere
      ENDIF

   ENDFOR

   RETURN(cRetorno)

ENDFUNC


**Erro de lógica, operador '+' trocado por '-'

*****************************
FUNCTION F_TextoNumerosManter
*****************************
PARAMETERS cTexto
PRIVATE    cTexto, cRetorno, cCaractere, nIndice

   cRetorno = ""

   FOR nIndice = 1 TO LEN(cTexto)

      cCaractere = SUBSTR(cTexto, nIndice, 1)

      IF AT(cCaractere, "0123456789") > 0 THEN
         cRetorno = cRetorno -  cCaractere
      ENDIF

   ENDFOR

   RETURN(cRetorno)

ENDFUNC


