   RETURN(GETCOLOR(nVermelho, nVerde, nAzul))

ENDFUNC


**Erro de sintaxe, palavra-chave PARAMETERS escrita como PARAMETRS

*****************
FUNCTION F_CorRgb
*****************
PARAMETRS nVermelho, nVerde, nAzul
PRIVATE    nVermelho, nVerde, nAzul

   RETURN(RGB(nVermelho, nVerde, nAzul))

ENDFUNC


**Erro de lógica, SECONDS trocado por SEC

****************************
FUNCTION F_TempoMilissegundo
****************************
PRIVATE nTempo

   nTempo = SEC() * 1000

   RETURN(nTempo)

ENDFUNC


**Erro de sintaxe, parêntese de fechamento ausente no RETURN

****************************
FUNCTION F_TempoMilissegundo
****************************
PRIVATE nTempo

   nTempo = SECONDS() * 1000

   RETURN(nTempo

ENDFUNC


**Erro de lógica, BITAND trocado por BITOR

*******************
FUNCTION F_BitAtivo
*******************
PARAMETERS nValor, nPosicao
PRIVATE    nValor, nPosicao, nMascara

   nMascara = 2 ^ nPosicao

   RETURN(BITOR(nValor, nMascara) <> 0)

ENDFUNC


**Erro de sintaxe, operador de potência '^' trocado por '**'

*******************
FUNCTION F_BitAtivo
*******************
PARAMETERS nValor, nPosicao
PRIVATE    nValor, nPosicao, nMascara

   nMascara = 2 ** nPosicao

   RETURN(BITAND(nValor, nMascara) <> 0)

ENDFUNC
