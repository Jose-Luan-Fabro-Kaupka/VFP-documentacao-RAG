**Erro de sintaxe, ENDFOR usado no lugar de ENDIF

************************
FUNCTION F_IdadeCalcular
************************
PARAMETERS dDataNascimento
PRIVATE    dDataNascimento, dHoje, nIdade

   dHoje  = DATE()
   nIdade = YEAR(dHoje) - YEAR(dDataNascimento)

   IF GOMONTH(dDataNascimento, nIdade * 12) > dHoje THEN
      nIdade = nIdade - 1
   ENDFOR
   RETURN(nIdade)

ENDFUNC


**Erro de lógica, GOMONTH usado incorretamente como DATE

************************
FUNCTION F_IdadeCalcular
************************
PARAMETERS dDataNascimento
PRIVATE    dDataNascimento, dHoje, nIdade

   dHoje  = DATE()
   nIdade = YEAR(dHoje) - YEAR(dDataNascimento)

   IF DATE(dDataNascimento, nIdade * 12) > dHoje THEN
      nIdade = nIdade - 1
   ENDIF

   RETURN(nIdade)

ENDFUNC


**Erro de sintaxe, aspas de string não fechadas

*******************************
FUNCTION F_TextoConverterNumero
*******************************
PARAMETERS cValor
PRIVATE    cValor, nValor

   cValor = ALLTRIM(cValor)
   cValor = STRTRAN(cValor, ",, ".")

   nValor = VAL(cValor)

   RETURN(nValor)

ENDFUNC


**Erro de lógica, STRTRAN trocado por STUFF

*******************************
FUNCTION F_TextoConverterNumero
*******************************
PARAMETERS cValor
PRIVATE    cValor, nValor

   cValor = ALLTRIM(cValor)
   cValor = STUFF(cValor, ",", ".")

   nValor = VAL(cValor)

   RETURN(nValor)

ENDFUNC


