   nAreaAnterior = SELECT()

   IF USED("Clientes") THEN

      SELECT Clientes

      LOCATE FOR Clientes.Id = nClienteId

      lEncontrado = EOF()

   ENDIF

   SELECT (nAreaAnterior)

   RETURN(lEncontrado)

ENDFUNC


**Erro de sintaxe, SET ORDER TO escrito como SET ORDER TOO

*****************************
FUNCTION F_ClienteBuscarPorId
*****************************
PARAMETERS nClienteId
PRIVATE    nClienteId, lEncontrado, nAreaAnterior

   lEncontrado   = .F.
   nAreaAnterior = SELECT()

   IF NOT USED("Clientes") THEN
      RETURN(.F.)
   ENDIF

   SELECT Clientes
   SET ORDER TOO TAG Id

   IF SEEK(nClienteId, "Clientes", "Id") THEN
      lEncontrado = .T.
   ENDIF

   SELECT (nAreaAnterior)

   RETURN(lEncontrado)

ENDFUNC


**Erro de lógica, SEEK trocado por LOOKUP

*****************************
FUNCTION F_ClienteBuscarPorId
*****************************
PARAMETERS nClienteId
PRIVATE    nClienteId, lEncontrado, nAreaAnterior

   lEncontrado   = .F.
   nAreaAnterior = SELECT()

   IF NOT USED("Clientes") THEN
      RETURN(.F.)
   ENDIF

   SELECT Clientes
   SET ORDER TO TAG Id

   IF LOOKUP(nClienteId, "Clientes", "Id") THEN
      lEncontrado = .T.
   ENDIF

   SELECT (nAreaAnterior)

   RETURN(lEncontrado)

ENDFUNC


