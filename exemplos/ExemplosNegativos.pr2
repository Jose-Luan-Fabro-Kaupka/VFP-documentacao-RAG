**Erro de sintaxe, palavra-chave PROCEDURE escrita como PROCEDUERE

**************************
PROCEDUERE P_MatrizInverter
**************************
PARAMETERS mValores
PRIVATE    mValores, uValor, nInicio, nFim

   nInicio = 1
   nFim    = ALEN(mValores)

   DO WHILE nInicio < nFim

      uValor            = mValores[nInicio]
      mValores[nInicio] = mValores[nFim]
      mValores[nFim]    = uValor

      nInicio = nInicio + 1
      nFim    = nFim - 1

   ENDDO

   RETURN

ENDPROC


**Erro de lógica, ALEN trocado por AELEMENT

**************************
PROCEDURE P_MatrizInverter
**************************
PARAMETERS mValores
PRIVATE    mValores, uValor, nInicio, nFim

   nInicio = 1
   nFim    = AELEMENT(mValores)

   DO WHILE nInicio < nFim

      uValor            = mValores[nInicio]
      mValores[nInicio] = mValores[nFim]
      mValores[nFim]    = uValor

      nInicio = nInicio + 1
      nFim    = nFim - 1

   ENDDO

   RETURN

ENDPROC


**Erro de lógica, TRANSFORM trocado por STR

****************************
FUNCTION F_MatrizTextoJuntar
****************************
PARAMETERS mValores, cSeparador
PRIVATE    mValores, cSeparador, cRetorno, nIndice

   cRetorno = ""

   FOR nIndice = 1 TO ALEN(mValores)

      IF nIndice > 1 THEN
         cRetorno = cRetorno + cSeparador
      ENDIF

      cRetorno = cRetorno + STR(mValores[nIndice])

   ENDFOR

   RETURN(cRetorno)

ENDFUNC


**Erro de sintaxe, ENDIF usado no lugar de ENDFOR

****************************
FUNCTION F_MatrizTextoJuntar
****************************
PARAMETERS mValores, cSeparador
PRIVATE    mValores, cSeparador, cRetorno, nIndice

   cRetorno = ""

   FOR nIndice = 1 TO ALEN(mValores)

      IF nIndice > 1 THEN
         cRetorno = cRetorno + cSeparador
      ENDIF

      cRetorno = cRetorno + TRANSFORM(mValores[nIndice])

   ENDIF
   RETURN(cRetorno)

ENDFUNC


**Erro de lógica, valor lógico .T. trocado por .F.

**************************
FUNCTION F_MatrizDuplicado
**************************
PARAMETERS mValores
PRIVATE    mValores, nIndice1, nIndice2

   FOR nIndice1 = 1 TO ALEN(mValores) - 1

      FOR nIndice2 = nIndice1 + 1 TO ALEN(mValores)

         IF mValores[nIndice1] = mValores[nIndice2] THEN
            RETURN(.F.)
         ENDIF

      ENDFOR

   ENDFOR

   RETURN(.F.)

ENDFUNC


**Erro de sintaxe, palavra TO escrita como TOO no FOR

**************************
FUNCTION F_MatrizDuplicado
**************************
PARAMETERS mValores
PRIVATE    mValores, nIndice1, nIndice2

   FOR nIndice1 = 1 TOO ALEN(mValores) - 1

      FOR nIndice2 = nIndice1 + 1 TO ALEN(mValores)

         IF mValores[nIndice1] = mValores[nIndice2] THEN
            RETURN(.T.)
         ENDIF

      ENDFOR

   ENDFOR

   RETURN(.F.)

ENDFUNC


